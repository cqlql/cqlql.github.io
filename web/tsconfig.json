{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // 测试用 `node --test test/*.test.ts` 直接跑 .ts，靠 Node 的类型剥离。
    // 类型剥离只删不转 —— enum / namespace / 参数属性这些「有运行时语义的语法」
    // 一律编不过，所以这里钉死 erasableSyntaxOnly，让 tsc 提前挡住它们。
    "erasableSyntaxOnly": true,

    // 🔴 src 内部的相对 import 一律写扩展名（`./x.ts` / `./x.tsx`）。
    // 原因：Node 的 ESM 解析**不会**自动补扩展名，而测试是直接 import 源码跑的
    // （没有打包器）。不写扩展名时，只有「纯 type-only import」才碰巧能过 ——
    // 一旦某个模块有运行时 import，`npm test` 就会 ERR_MODULE_NOT_FOUND。
    // 与其记「哪些文件只能 type-only import」，不如统一写扩展名。
    "allowImportingTsExtensions": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
  // ⚠️ test/ 故意不在 include 里：它 import 了 node:test，而本项目没有
  // @types/node（不想为一个测试多引一层类型依赖）。代价是 tsc 看不到测试文件，
  // 所以改完 web/ 一律 `npm test && npm run typecheck` **两个都跑**。
}
