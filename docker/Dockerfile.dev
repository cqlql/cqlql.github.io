FROM node:24-slim AS node_env
FROM ubuntu:24.04 AS builder

# 避免交互式安装时的提示
ENV DEBIAN_FRONTEND=noninteractive

# 1. 配置 apt 换源 (阿里云) + 安装系统基础工具
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list.d/ubuntu.sources && \
    sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. 从 node 镜像中把 node 和 npm 直接拷过来
COPY --from=node_env /usr/local/bin /usr/local/bin
COPY --from=node_env /usr/local/lib/node_modules /usr/local/lib/node_modules

# 3. 配置 Corepack 环境变量（镜像源 + 禁用下载交互确认提示）
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# 4. 启用 Corepack 并初始化 pnpm（版本与项目 packageManager 一致）
# 仅 enable pnpm，避免 corepack enable 为缺失的 yarn 软链创建链接时报 ENOENT
RUN corepack enable pnpm && corepack prepare pnpm@10.30.3 --activate \
    && pnpm config set registry https://registry.npmmirror.com \
    && pnpm config set fetch-timeout 600000
