{
  "name": "cqlql-notes",
  "version": "2.0.0",
  "description": "A project of vuepress-theme-hope",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vuepress-vite dev docs",
    "docs:build": "vuepress-vite build docs",
    "docs:clean-dev": "vuepress-vite dev docs --clean-cache",
    "docs:dev": "vuepress-vite dev docs",
    "docs:update-package": "pnpm dlx vp-update",
    "docker": "docker-compose -f docker/docker-compose.yml up -d && pnpm run docker:sync",
    "docker:sync": "pnpm run docs:build && docker run --rm -v cqlql-notes-dist:/dest -v ./docs/.vuepress/dist:/src:ro nginx:1.30.4-trixie sh -c \"find /dest -mindepth 1 -delete && cp -a /src/. /dest/\"",
    "git:auto": "start /b \"\" .\\git-auto-push.bat"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-shiki": "2.0.0-rc.0",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.131",
    "front-matter": "^4.0.2",
    "mermaid": "^11.17.2",
    "sass-embedded": "^1.100.0",
    "vue": "^3.5.41",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@iconify/vue": "^5.0.1"
  }
}
