# fake = 离线演示（不需要任何密钥）；doubao = 火山方舟；vllm = 本地服务
LLM_PROVIDER=fake

# 豆包
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=deepseek-v4-1-flash-260910
DOUBAO_API_KEY=

# 本地 vLLM（与 pass-up.ai 共用同一台服务时直接抄那边的地址）
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen3.5-4B
VLLM_API_KEY=EMPTY

# 硬约束：到上限降级，不抛异常
AGENT_MAX_ROUNDS=5
AGENT_MAX_REPEATS=2
AGENT_TOTAL_TIMEOUT=60

# 接真接口时才用；现在三个工具都读 data/fake/
PASS_UP_API_BASE=
