# 复制成 .env 后填写。.env 已在 .gitignore 里，不会进仓库。

# ── 语料 ──────────────────────────────────────────────
# 笔记站 md 目录（绝对路径）
CORPUS_DIR=D:/_work/cqlql-notes/docs

# ── 生成模型（豆包，OpenAI 兼容协议）────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-pro-32k

# 想用本地 vLLM 就改成：
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen3.5-4B
# LLM_API_KEY=not-needed

# ── 向量库（做对比实验用）────────────────────────────
# 先起库：docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/notesrag

# ── 检索参数（改完记得重跑 evaluate.py）─────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=51
TOP_K=5
RERANK_TOP_N=20
