# 复制成 .env 后填写。.env 已在 .gitignore 里，不会进仓库。

# ── 语料 ──────────────────────────────────────────────
# 笔记站 md 目录（绝对路径）
CORPUS_DIR=D:/_work/cqlql-notes/docs

# ── Embedding 模型 ─────────────────────────────────────
# 不填则用 BAAI/bge-m3（走 HF）；HF 不通时可填本地权重目录的绝对路径
# EMBED_MODEL=BAAI/bge-m3

# ── 生成模型（豆包，OpenAI 兼容协议）────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-pro-32k

# 想用本地 vLLM 就改成：
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen3.5-4B
# LLM_API_KEY=not-needed

# ── 向量库（做对比实验用）────────────────────────────
# 先起库：docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/notesrag

# ── 检索参数（改完记得重跑 ingest.py + evaluate.py）─────
# 切分策略：fixed = 固定长度 baseline / heading = 标题感知（**当前默认**）
# 两种策略共用同一份代码与同一份 queries.jsonl，只改这里就能做前后对比
CHUNK_STRATEGY=heading
CHUNK_SIZE=512
CHUNK_OVERLAP=51
# 短 section 合并阈值：正文字符 < 该值的 section 向前并进上一节（0 = 不合并）
# 合并后不超过 CHUNK_SIZE 才并；120 实测结构更干净（碎片 166→41）但检索无净收益，
# 默认 0，数字与归因见 learning/实验台账.md §2.1。改这里要重建索引
MERGE_MIN_CHARS=0
TOP_K=5

# ── 两段式检索（纯向量 vs 向量+rerank 的对照开关）─────────
# 粗召回 top-N → cross-encoder 精排 → 取 TOP_K
# 对比时只改 RERANK_ENABLED：代码、索引、评估集都不动（改完重跑 evaluate.py 即可）
# 默认 false：50 条评估集上没证明净收益（见 learning/实验台账.md §2）
RERANK_ENABLED=false
RERANK_TOP_N=20
# 不填则走 HF 的 BAAI/bge-reranker-v2-m3；HF 不通时填本地权重目录的绝对路径
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
