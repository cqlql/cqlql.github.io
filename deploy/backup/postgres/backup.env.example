# ==========================================
# PostgreSQL 备份环境变量配置模板
# 由 internal/shared/env-schema.json 生成，请勿手改。
# 改键 / 默认值：改 schema 后运行 ops __gen-backup-env；漏生成会被 go test 挡住。
# 复制为 backup.env 后填入真实值，勿提交 backup.env 到 Git
# ==========================================

# ---------- 主服务器 ----------
# 与 docker/docker-compose.base.yml 的 container_name 保持一致，位于主服务器上
PG_CONTAINER_NAME="postgres"

# 与 docker/.env 的 POSTGRES_USER / POSTGRES_DB 保持一致
PG_DB_USER="postgres"

PG_DB_NAME="pass_up"

# ---------- SSH 连接（备份端 → 主服务器） ----------
# 主服务器地址（IP 或域名）；pull 模式：备份端通过 SSH 从主服务器拉取 dump
PG_SSH_HOST=""

PG_SSH_PORT="22"

# 需有权限执行 docker exec
PG_SSH_USER="root"

# 用于免密登录主服务器的 SSH 私钥路径
PG_SSH_KEY=""

# 默认禁交互 + 10s 连接超时 + 首次收录主机密钥（变化即拒绝）。
# 与 pg_backup.sh / pg_restore.sh 的兜底默认值、ops 自身 ssh 封装口径一致。
# 注意：不要用 StrictHostKeyChecking=no（关掉主机密钥校验）；BatchMode=yes 下不加 accept-new，
# cron 首次连接一台没进 known_hosts 的主机会直接失败。accept-new 需 OpenSSH >= 7.6。
# 留空不写这一项时，脚本会用上面这串内置默认值。
PG_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"

# ---------- 备份端 ----------
# 脚本会自动在其下创建 daily / weekly / monthly 分级子目录
PG_BACKUP_ROOT="/data/backups/postgres"

# pg_backup.sh / pg_backup_status.sh 共用，需与脚本内兜底默认值一致
PG_BACKUP_LOG_DIR="/var/log/pg-backup"

# 本地 daily 目录保留天数；改这里会同步到所有脚本兜底值
PG_LOCAL_RETENTION_DAYS="7"

# 每周一生成的备份
PG_WEEKLY_RETENTION_DAYS="30"

# 每月 1 号生成的备份
PG_MONTHLY_RETENTION_DAYS="365"

# pg_restore 并行线程数（按 CPU 核数调整，单机一般 4）
PG_RESTORE_JOBS="4"

# ---------- 定时任务 ----------
# Makefile / install.sh 统一读取，避免多处重复定义
# 默认每天凌晨 3:00，错开 MinIO 的 2:00
CRON_SCHEDULE_BACKUP="0 3 * * *"

# 默认每天 9:00
CRON_SCHEDULE_HEALTH="0 9 * * *"

# ---------- 巡检 ----------
# 距上次成功超过该值即告警（每日 Cron 跑建议 ~26，留 2h 余量）
BACKUP_HEALTH_THRESHOLD_HOURS="26"

# 巡检 df 用，监控备份写入盘是否写满，如 /data /mnt/backup
BACKUP_DISK_MOUNT="/data"

# 备份端磁盘使用率达到该值即判定异常并告警
BACKUP_DISK_CRIT_PCT="90"

# 异常时主动推送告警的 Webhook（飞书/钉钉/企微机器人地址），留空则仅打印不推送
ALERT_WEBHOOK=""
