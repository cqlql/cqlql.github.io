# ==========================================
# PostgreSQL 备份环境变量配置模板
# 复制为 backup.env 后填入真实值，勿提交 backup.env 到 Git
# ==========================================

# PG 容器名称（与 docker/docker-compose.base.yml 的 container_name 保持一致，位于主服务器上）
PG_CONTAINER_NAME="postgres"
# 数据库用户名 / 目标数据库名（与 docker/.env 的 POSTGRES_USER / POSTGRES_DB 保持一致）
PG_DB_USER="postgres"
PG_DB_NAME="pass_up"

# ---------- 主服务器 SSH 连接（pull 模式：备份端通过 SSH 从主服务器拉取 dump） ----------
# 主服务器地址（IP 或域名）
PG_SSH_HOST=""
# SSH 端口（默认 22）
PG_SSH_PORT="22"
# SSH 登录用户（需有权限执行 docker exec）
PG_SSH_USER="root"
# SSH 私钥路径（用于免密登录主服务器）
PG_SSH_KEY=""
# 额外 SSH 选项（默认 BatchMode 禁交互 + 连接超时 10s；首次需已加入 known_hosts 或追加 -o StrictHostKeyChecking=no）
PG_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"

# 备份端本地备份根目录（脚本会自动在其下创建 daily / weekly / monthly 分级子目录）
PG_BACKUP_ROOT="/data/backups/postgres"
# 日志目录（pg_backup.sh / pg_backup_status.sh 共用，需与脚本内硬编码默认值一致）
PG_BACKUP_LOG_DIR="/var/log/pg-backup"
# 本地 daily 目录保留天数
PG_LOCAL_RETENTION_DAYS="7"
# 本地 weekly 目录保留天数（每周一生成的备份）
PG_WEEKLY_RETENTION_DAYS="30"
# 本地 monthly 目录保留天数（每月 1 号生成的备份）
PG_MONTHLY_RETENTION_DAYS="365"
# pg_restore 并行线程数（按 CPU 核数调整，单机一般 4）
PG_RESTORE_JOBS="4"
# 定时任务时间（Makefile / install.sh 统一读取，避免多处重复定义）
# 备份任务（默认每天凌晨 3:00，错开 MinIO 的 2:00）
CRON_SCHEDULE_BACKUP="0 3 * * *"
# 健康巡检任务（默认每天 9:00）
CRON_SCHEDULE_HEALTH="0 9 * * *"

# ---------- 健康巡检选项（pg_backup_status.sh 读取） ----------
# 健康度阈值（小时）：距上次成功超过该值即告警（每日 Cron 跑建议 ~26，留 2h 余量）
BACKUP_HEALTH_THRESHOLD_HOURS="26"
# 备份端本机 PG 备份数据盘挂载点（巡检 df 用，监控备份写入盘是否写满，如 /data /mnt/backup）
BACKUP_DISK_MOUNT="/data"
# 磁盘使用率告警阈值（百分比）：备份端磁盘使用率达到该值即判定异常并告警
BACKUP_DISK_CRIT_PCT="90"
# 可选：异常时主动推送告警的 Webhook（飞书/钉钉/企微机器人地址），留空则仅打印不推送
ALERT_WEBHOOK=""
