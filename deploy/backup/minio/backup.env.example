# ==========================================
# MinIO 备份环境变量配置模板
# 复制为 backup.env 后填入真实值，勿提交 backup.env 到 Git
# ==========================================

# ---------- 生产端（源）MinIO 配置 ----------
SRC_URL="http://127.0.0.1:8007"
SRC_KEY="CHANGE_ME_PROD_ACCESS_KEY"
SRC_SECRET="CHANGE_ME_PROD_SECRET_KEY"

# 生产端需要备份的桶列表（空格分隔）
# 当前项目桶: passup-public passup-private passup-temp
SRC_BUCKETS="passup-public passup-private passup-temp"

# ---------- 备份端（目标）MinIO 配置 ----------
# 脚本运行在备份端本机，DEST_URL 通常指向本机 MinIO（如 127.0.0.1:9000 或本机数据盘）
DEST_URL="http://127.0.0.1:9000"
DEST_KEY="YOUR_BACKUP_ACCESS_KEY"
DEST_SECRET="YOUR_BACKUP_SECRET_KEY"

# 备份端桶前缀（备份桶名 = 前缀 + 生产端桶名，如 passup-backup-passup-public）
DEST_BUCKET_PREFIX="passup-backup-"

# 备份端本机 MinIO 容器名（preflight_check.sh 读取，用于 docker inspect 核对容器数据目录
# 是否真实挂载到宿主机数据盘；留空则跳过该项检查）
MINIO_CONTAINER_NAME=""

# ---------- 备份选项 ----------
# 是否启用上传限速（公网传输建议限制，如 "50M"；局域网留空即可）
UPLOAD_LIMIT=""
# 日志目录（minio_backup.sh / minio_backup_status.sh 共用，默认 /var/log/minio-backup）
BACKUP_LOG_DIR="/var/log/minio-backup"
# 定时任务时间（Makefile / install.sh 统一读取，避免多处重复定义）
# 备份任务（默认每天凌晨 2:00）
CRON_SCHEDULE_BACKUP="0 2 * * *"
# 健康巡检任务（默认每天 8:00）
CRON_SCHEDULE_HEALTH="0 8 * * *"

# ---------- 健康巡检选项（minio_backup_status.sh 读取） ----------
# 备份端本机 MinIO 数据盘挂载点（巡检 df 用，监控备份写入盘是否写满，如 /data /mnt/backup）
BACKUP_DISK_MOUNT="/data"
# 健康度阈值（小时）：距上次成功超过该值即告警（每日 Cron 跑建议 ~26，留 2h 余量）
BACKUP_HEALTH_THRESHOLD_HOURS="26"
# 磁盘使用率告警阈值（百分比）：备份端磁盘使用率达到该值即判定异常并告警
BACKUP_DISK_CRIT_PCT="90"
# 可选：异常时主动推送告警的 Webhook（飞书/钉钉/企微机器人地址），留空则仅打印不推送
ALERT_WEBHOOK=""
